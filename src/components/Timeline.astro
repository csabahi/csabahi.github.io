---
interface TimelineEvent {
  date: string;
  title: string;
  description: string;
}

interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;
---

<div class="timeline">
  {events.map((event) => (
    <div class="timeline-item">
      <div class="timeline-content">
        <div class="date">{event.date}</div>
        <h3 set:html={event.title}></h3>
        <p set:html={event.description}></p>
      </div>
    </div>
  ))}
</div>

<style>
  .timeline {
    /* Horizontal center of the line and dots, measured from the timeline's left edge */
    --line-x: 31px;
    --item-indent: 70px;
    position: relative;
    max-width: 800px;
    margin: 2rem auto;
    padding: 1rem 0;
  }
  
  .timeline::after {
    content: '';
    position: absolute;
    width: 4px;
    background: rgb(var(--accent));
    top: 0;
    bottom: 0;
    left: var(--line-x);
    transform: translateX(-50%);
  }
  
  .timeline-item {
    padding: 10px 30px;
    position: relative;
    width: 100%;
    padding-left: var(--item-indent);
    padding-right: 25px;
  }
  
  .timeline-content {
    padding: 1rem;
    background: rgba(var(--accent-dark), 0.2);
    border: 1px solid rgba(var(--accent-light), 0.2);
    border-radius: 8px;
    position: relative;
    font-size: 0.9rem;
  }
  
  .timeline-content::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    background: rgb(var(--accent));
    border-radius: 50%;
    top: 50%;
    /* -1px offsets the card's border, since absolute positioning starts inside it */
    left: calc(var(--line-x) - var(--item-indent) - 1px);
    transform: translate(-50%, -50%);
    z-index: 1;
  }
  
  .date {
    color: rgb(var(--accent-light));
    font-size: 0.8rem;
    margin-bottom: 0.3rem;
  }
  
  h3 {
    margin: 0 0 0.3rem 0;
    color: white;
    font-size: 1rem;
  }
  
  p {
    margin: 0;
    line-height: 1.4;
    font-size: 0.9rem;
  }

  h3 :global(a), p :global(a) {
    color: rgb(var(--accent-light));
    text-decoration: none;
    transition: color 0.2s;
  }

  h3 :global(a:hover), p :global(a:hover) {
    color: rgb(var(--accent));
  }
  
  @media (max-width: 768px) {
    .timeline {
      padding-left: 0;
    }
  }
</style>